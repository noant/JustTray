<UserControl x:Class="JustTray.Views.Controls.ShortcutsRunnerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:JustTray.Views.Controls"
             x:Name="Root">
    
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Shortcuts List -->
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto">
                <ListBox ItemsSource="{Binding Shortcuts}"
                         x:Name="ShortcutsList"
                         Background="Transparent"
                         BorderThickness="0"
                         AllowDrop="{Binding ElementName=Root, Path=ShowAddButton}"
                         PreviewMouseLeftButtonDown="ShortcutsList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="ShortcutsList_PreviewMouseMove"
                         Drop="ShortcutsList_Drop"
                         DragOver="ShortcutsList_DragOver">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <controls:ShortcutItemControl 
                                ClickCommand="{Binding DataContext.ShortcutClickedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
            
            <!-- Empty State -->
            <TextBlock Grid.Row="0"
                       Text="No shortcuts configured"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontSize="14"
                       Margin="20"
                       Visibility="{Binding Shortcuts.Count, Converter={StaticResource ZeroToVisibleConverter}}"/>
            
            <!-- Add Button (only in settings mode) -->
            <Button Grid.Row="1"
                    Content="+ Add Shortcut"
                    Command="{Binding ElementName=Root, Path=AddCommand}"
                    Style="{StaticResource AddButtonStyle}"
                    Visibility="{Binding ElementName=Root, Path=ShowAddButton, Converter={StaticResource BoolToVisibilityConverter}}"
                    Margin="8"/>
        </Grid>
    </Border>
</UserControl>
