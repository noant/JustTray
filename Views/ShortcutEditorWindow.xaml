<Window x:Class="JustTray.Views.ShortcutEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Shortcut"
        Width="420"
        Height="810"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        ResizeMode="NoResize">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0">
            <!-- Name -->
            <TextBlock Text="Name"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,8"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBoxStyle}"
                     Margin="0,0,0,20"/>
            
            <!-- Executable Path -->
            <TextBlock Text="Executable Path"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding ExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"/>
                <Button Grid.Column="1"
                        Content="..."
                        Command="{Binding BrowseExecutableCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="40"
                        Margin="8,0,0,0"/>
            </Grid>
            
            <!-- Arguments -->
            <TextBlock Text="Arguments (optional)"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,8"/>
            <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBoxStyle}"
                     Margin="0,0,0,16"/>
            
            <!-- Working Directory -->
            <TextBlock Text="Working Directory (optional)"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,8"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBoxStyle}"/>
                <Button Grid.Column="1"
                        Content="..."
                        Command="{Binding BrowseWorkingDirectoryCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="40"
                        Margin="8,0,0,0"/>
            </Grid>
            
            <!-- Run as Admin -->
            <CheckBox Content="Run as Administrator"
                      IsChecked="{Binding RunAsAdmin}"
                      Style="{StaticResource ModernCheckBoxStyle}"
                      Margin="0,0,0,16"/>
            
            <!-- Window Style -->
            <TextBlock Text="Window Style"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,8"/>
            <ComboBox ItemsSource="{Binding WindowStyles}"
                      SelectedItem="{Binding WindowStyle}"
                      Style="{StaticResource ModernComboBoxStyle}"
                      Margin="0,0,0,20"/>
            
            <!-- Icon Color -->
            <TextBlock Text="Icon Color"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="0,0,0,8"/>
            
            <CheckBox Content="Use Windows accent color"
                      IsChecked="{Binding UseWindowsAccentColor}"
                      Style="{StaticResource ModernCheckBoxStyle}"
                      Margin="0,0,0,12"/>
            
            <!-- Color Palette -->
            <ItemsControl x:Name="ColorPalette"
                          ItemsSource="{Binding PredefinedColors}"
                          Opacity="{Binding UseWindowsAccentColor, Converter={StaticResource BoolToOpacityConverter}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="32" Height="32"
                                Margin="2"
                                Cursor="Hand"
                                Background="Transparent"
                                PreviewMouseLeftButtonDown="ColorItem_Click"
                                Tag="{Binding}">
                            <Grid>
                                <Ellipse Fill="{Binding Converter={StaticResource StringToBrushConverter}}"
                                         Width="28" Height="28"
                                         IsHitTestVisible="False"/>
                                <Ellipse x:Name="SelectionRing"
                                         Stroke="{DynamicResource TextBrush}"
                                         StrokeThickness="2"
                                         Width="28" Height="28"
                                         IsHitTestVisible="False">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource ColorMatchConverter}">
                                                            <Binding Path="DataContext.IconColor" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            <Binding/>
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        
        <!-- Buttons -->
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0"
                    Content="Delete"
                    Command="{Binding DeleteCommand}"
                    Style="{StaticResource DangerButtonStyle}"
                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibilityConverter}}"/>
            
            <Button Grid.Column="2"
                    Content="Cancel"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,8,0"/>
            
            <Button Grid.Column="3"
                    Content="Save"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>
    </Grid>
</Window>
