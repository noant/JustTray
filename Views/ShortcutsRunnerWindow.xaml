<Window x:Class="JustTray.Views.ShortcutsRunnerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:JustTray.Views.Controls"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MinWidth="280"
        MaxWidth="350"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated">
    
    <Window.Resources>
        <DropShadowEffect x:Key="WindowShadow"
                          BlurRadius="20"
                          ShadowDepth="2"
                          Direction="270"
                          Opacity="0.3"
                          Color="Black"/>
    </Window.Resources>
    
    <Border Effect="{StaticResource WindowShadow}"
            Margin="20">
        <controls:ShortcutsRunnerControl ShowAddButton="False"/>
    </Border>
</Window>
